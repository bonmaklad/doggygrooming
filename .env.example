# Server only. Copy to .env; never use NEXT_PUBLIC_ for these values.
ADMIN_PASSWORD=

# The Google account must own or have write access to the grooming calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEZONE=Pacific/Auckland
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Optional: show only contacts with this Google Contacts label resource name.
# Booking customers from the calendar are always included.
GOOGLE_CONTACT_GROUP=

# Optional: public origin when the reverse proxy uses a different internal host.
# APP_ORIGIN=https://your-domain.example
